{% extends 'base.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
    <section class="category-card">
        <h1 class="page-title h2 mb-4">{{ category.name }}</h1>

        <div class="table-responsive">
            <table class="table align-middle category-table">
                <tbody>
                    <tr>
                        <th scope="row">Id</th>
                        <td>{{ category.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Nazwa</th>
                        <td>{{ category.name }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Opis</th>
                        <td>{{ category.description }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-secondary" href="{{ path('app_category_index') }}">Wróć do listy</a>
            <a class="btn btn-primary" href="{{ path('app_category_edit', {'id': category.id}) }}">Edytuj</a>
        </div>

        <div class="mt-3">
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </section>
{% endblock %}
